# cluster.env for the OFFICIAL nvidia checkpoint + DFlash2 drafter at TP=3.
# Copy to cluster.env on every node. Same file everywhere; rank derived from NODES.
#
# This variant is nvidia/GLM-5.3-Flash-NVFP4 on the exact DFlash2 TP=3 lane the
# LibertAIDAI dflash variant uses -- same v12 image, same 48q/12kv padded drafter,
# same overlays. Only the checkpoint and a few nvidia-only knobs differ, and every
# knob here rides serve.sh's existing config/passthroughs: serve.sh needs no edit.
# See the README "Checkpoint variants" section.
#
# QUALITY: measured clean (parallel-1 TEB 2.6.1.dev65, identical config, only the
# checkpoint differing) LibertAIDAI scores 94 and nvidia 90 -- nvidia's static 4-bit
# input-activation quant (cnn_dailymail calibration) costs ~4 TEB points. Speculation
# method does not affect quality (rejection sampling is exact). Pick LibertAIDAI
# (cluster.env.example) for top quality; pick nvidia for the official/licensed weights.

# --- rendezvous (edit for your cluster; see cluster.env.example for details) ---
NODES="192.168.2.36 192.168.2.37 192.168.2.38"
IFACE=enP7s7
TRANSPORT=ib
IB_HCAS=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1

# --- the nvidia checkpoint (NOT LibertAIDAI) ---
# nvidia ships NO chat template: copy a GLM-5.3 chat_template.jinja INTO this dir first;
# serve.sh reads $MODEL_DIR/$CHAT_TEMPLATE. See README "Checkpoint variants".
MODEL_DIR=/home/user/.cache/model-shelf/models/safetensors/nvidia/GLM-5.3-Flash-NVFP4
UPSTREAM_DIR=/home/user/src/GLM-5.3-Flash-3x-DGX-Sparks
OVERLAY_DIR=/home/user/src/glm53-overlay
PORT=8045

# --- DFlash2 drafter: same v12 image + same 48q/12kv pad as the LibertAIDAI dflash lane ---
IMAGE=glm53:sm121-v12-dflash2
SPEC_METHOD=dflash
DFLASH_TOKENS=4                              # nvidia's measured best (serve.sh default is 7)
DFLASH2_DIR=$HOME/glm53-dflash2-draft-tp3    # the 48q/12kv padded drafter (checkpoint-independent)

# --- decode/memory set measured for nvidia at TP=3, 512K ---
MAX_MODEL_LEN=524288
KV_CACHE_MEMORY=6979321856                   # 6.5 GiB pinned -> 512K unaffected
MAX_NUM_SEQS=8
MAX_BATCHED_TOKENS=6144
GPU_MEM_UTIL=0.62                            # headroom for the DFlash2 JIT compile
ENFORCE_EAGER=0                              # CUDA graphs on (recovers prefill)

# --- nvidia-only knobs, via serve.sh's existing EXTRA_ARGS / EXTRA_ENV passthroughs ---
# video=0: nvidia's unquantized video encoder profiling OOMs the head node; image<=2 kept.
EXTRA_ARGS="--limit-mm-per-prompt image=2,video=0"
# Bound the FlashInfer + TileLang JIT so a cold cache does not fork-bomb the node to OOM;
# point the caches at the mounted /cache (serve.sh mounts $CACHE_DIR:/cache) so compiled
# kernels persist across container recreates instead of recompiling every 'up'.
EXTRA_ENV="-e MAX_JOBS=2 -e FLASHINFER_NVCC_THREADS=1 -e TILELANG_CACHE_DIR=/cache/tilelang -e TRITON_CACHE_DIR=/cache/triton"

# Optional: default reasoning verbosity (low|high; unset = model default max).
# REASONING_EFFORT=high
